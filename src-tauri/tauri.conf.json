{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ddugit",
  "version": "0.3.0",
  "identifier": "com.ddugit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ddugit",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#05040e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Graph-first Git client",
    "copyright": "© ddugit",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  }
}
